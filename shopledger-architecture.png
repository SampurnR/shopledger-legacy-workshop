<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="2200" height="1480" viewBox="0 0 2200 1480" role="img" aria-labelledby="title desc">
  <title id="title">ShopLedger application architecture</title>
  <desc id="desc">Architecture map for the ShopLedger browser UI, Express server, four route modules, ten library modules, configuration, JSON store, and order placement flow.</desc>
  <defs>
    <marker id="arrow" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto"><path d="M0,0 L10,5 L0,10 Z" fill="#526782"/></marker>
    <marker id="arrowTeal" markerWidth="10" markerHeight="10" refX="8" refY="5" orient="auto"><path d="M0,0 L10,5 L0,10 Z" fill="#0f9d8a"/></marker>
    <filter id="shadow" x="-10%" y="-10%" width="120%" height="130%"><feDropShadow dx="0" dy="3" stdDeviation="5" flood-color="#10213a" flood-opacity=".08"/></filter>
    <style>
      .title{font:700 38px 'Segoe UI',Arial,sans-serif;fill:#10213a}
      .subtitle{font:16px 'Segoe UI',Arial,sans-serif;fill:#526782}
      .panel{fill:#fff;stroke:#d9e2ee;stroke-width:1.5;filter:url(#shadow)}
      .panelhead{font:700 20px 'Segoe UI',Arial,sans-serif;fill:#10213a}
      .path{font:600 13px 'Segoe UI',Arial,sans-serif;fill:#0f766e}
      .label{font:700 16px 'Segoe UI',Arial,sans-serif;fill:#10213a}
      .body{font:14px 'Segoe UI',Arial,sans-serif;fill:#526782}
      .small{font:12px 'Segoe UI',Arial,sans-serif;fill:#64748b}
      .chip{font:600 12px 'Segoe UI',Arial,sans-serif;fill:#27445f}
      .module{fill:#f8fbff;stroke:#d9e5f0;stroke-width:1.2}
      .router{fill:#f1fbf9;stroke:#a8ded4;stroke-width:1.2}
      .tag{font:700 11px 'Segoe UI',Arial,sans-serif;fill:#0f766e}
      .stepnum{font:700 15px 'Segoe UI',Arial,sans-serif;fill:#fff}
      .stephead{font:700 15px 'Segoe UI',Arial,sans-serif;fill:#10213a}
      .stepbody{font:13px 'Segoe UI',Arial,sans-serif;fill:#526782}
    </style>
  </defs>
  <rect width="2200" height="1480" fill="#f3f7fb"/>
  <text class="title" x="48" y="62">ShopLedger · Application Architecture</text>
  <text class="subtitle" x="50" y="94">Browser POS · Express routes · business modules · JSON-file persistence</text>
  <image x="1710" y="0" width="440" height="220" preserveAspectRatio="xMidYMid meet" href="data:image/png;base64,"/>

  <!-- UI -->
  <rect class="panel" x="40" y="150" width="350" height="650" rx="16"/>
  <text class="panelhead" x="64" y="190">Browser UI</text>
  <text class="path" x="64" y="215">public/</text>
  <rect class="module" x="62" y="238" width="306" height="76" rx="10"/>
  <text class="label" x="80" y="267">index.html</text>
  <text class="body" x="80" y="291">single-page shop workspace</text>
  <rect class="module" x="62" y="326" width="306" height="76" rx="10"/>
  <text class="label" x="80" y="355">js/app.js</text>
  <text class="body" x="80" y="379">XHR requests · cart · screen updates</text>
  <rect class="module" x="62" y="414" width="306" height="76" rx="10"/>
  <text class="label" x="80" y="443">css/style.css</text>
  <text class="body" x="80" y="467">layout and visual styles</text>
  <text class="small" x="64" y="529">UI sections</text>
  <rect x="62" y="546" width="140" height="38" rx="19" fill="#e8f4ff"/><text class="chip" x="83" y="570">New Bill</text>
  <rect x="214" y="546" width="154" height="38" rx="19" fill="#e8f4ff"/><text class="chip" x="237" y="570">Order History</text>
  <rect x="62" y="596" width="140" height="38" rx="19" fill="#e8f4ff"/><text class="chip" x="87" y="620">Customer Khata</text>
  <rect x="214" y="596" width="154" height="38" rx="19" fill="#e8f4ff"/><text class="chip" x="235" y="620">Inventory &amp; GST Audit</text>
  <text class="small" x="64" y="680">Payment mode is recorded on the order.</text>
  <text class="body" x="64" y="706">Cash · UPI · Khata</text>
  <text class="small" x="64" y="753">Invoice opens as printable HTML.</text>

  <!-- Server -->
  <rect class="panel" x="430" y="150" width="450" height="170" rx="16"/>
  <text class="panelhead" x="454" y="190">Express application</text>
  <text class="path" x="454" y="215">server.js</text>
  <text class="body" x="454" y="248">Serves public/ · mounts four routers at /api</text>
  <text class="body" x="454" y="273">Also serves GET /orders/:id/invoice</text>
  <text class="small" x="454" y="298">Default port: config.js → 3000</text>

  <!-- Routers -->
  <rect class="panel" x="430" y="345" width="450" height="455" rx="16"/>
  <text class="panelhead" x="454" y="383">Routers · routes/</text>
  <rect class="router" x="452" y="402" width="406" height="84" rx="10"/>
  <text class="label" x="470" y="429">products.js</text>
  <text class="body" x="470" y="453">GET /products · GET /coupons</text>
  <rect class="router" x="452" y="496" width="406" height="98" rx="10"/>
  <text class="label" x="470" y="523">orders.js</text>
  <text class="body" x="470" y="547">GET /orders · POST /orders</text>
  <text class="body" x="470" y="570">GET /orders/:id · POST /orders/:id/cancel</text>
  <rect class="router" x="452" y="604" width="406" height="84" rx="10"/>
  <text class="label" x="470" y="631">customers.js</text>
  <text class="body" x="470" y="655">GET /customers · POST /customers/:id/settle</text>
  <rect class="router" x="452" y="698" width="406" height="82" rx="10"/>
  <text class="label" x="470" y="725">reports.js</text>
  <text class="body" x="470" y="749">dashboard · pricing/preview · GST reconciliation · export</text>

  <!-- Library modules -->
  <rect class="panel" x="920" y="150" width="850" height="650" rx="16"/>
  <text class="panelhead" x="944" y="190">Business modules · lib/</text>
  <rect class="module" x="944" y="210" width="392" height="94" rx="10"/>
  <text class="label" x="962" y="239">pricing.js</text><text class="body" x="962" y="264">subtotal · coupon allocation · line GST</text><text class="small" x="962" y="285">uses tax.js and coupons.js</text>
  <rect class="module" x="1352" y="210" width="392" height="94" rx="10"/>
  <text class="label" x="1370" y="239">tax.js</text><text class="body" x="1370" y="264">HSN slab lookup · CGST/SGST split</text><text class="small" x="1370" y="285">reads config.js</text>

  <rect class="module" x="944" y="316" width="392" height="94" rx="10"/>
  <text class="label" x="962" y="345">coupons.js</text><text class="body" x="962" y="370">normalizes · validates · calculates discounts</text><text class="small" x="962" y="391">reads config.js</text>
  <rect class="module" x="1352" y="316" width="392" height="94" rx="10"/>
  <text class="label" x="1370" y="345">inventory.js</text><text class="body" x="1370" y="370">stock checks · reserve/release · summary</text><text class="small" x="1370" y="391">reads config.js</text>

  <rect class="module" x="944" y="422" width="392" height="94" rx="10"/>
  <text class="label" x="962" y="451">orders.js</text><text class="body" x="962" y="476">add · get · cancel · list</text><text class="small" x="962" y="497">uses dates.js, inventory.js, ledger.js</text>
  <rect class="module" x="1352" y="422" width="392" height="94" rx="10"/>
  <text class="label" x="1370" y="451">ledger.js</text><text class="body" x="1370" y="476">Khata balances · credit checks · settlements</text><text class="small" x="1370" y="497">uses dates.js</text>

  <rect class="module" x="944" y="528" width="392" height="94" rx="10"/>
  <text class="label" x="962" y="557">dates.js</text><text class="body" x="962" y="582">DD/MM/YYYY date helpers · fiscal-year helper</text>
  <rect class="module" x="1352" y="528" width="392" height="94" rx="10"/>
  <text class="label" x="1370" y="557">reports.js</text><text class="body" x="1370" y="582">dashboard summary · GST reconciliation</text><text class="small" x="1370" y="603">uses inventory.js, ledger.js, invoice.js</text>

  <rect class="module" x="944" y="634" width="392" height="94" rx="10"/>
  <text class="label" x="962" y="663">invoice.js</text><text class="body" x="962" y="688">printable HTML invoice · shared pricing totals</text><text class="small" x="962" y="709">uses pricing.js and config.js</text>
  <rect class="module" x="1352" y="634" width="392" height="94" rx="10"/>
  <text class="label" x="1370" y="663">store.js</text><text class="body" x="1370" y="688">reads/writes JSON · appends audit entries</text><text class="small" x="1370" y="709">path: data/db.json</text>

  <rect x="944" y="746" width="800" height="38" rx="9" fill="#eaf8f6"/>
  <text class="small" x="962" y="770">Order route uses pricing, coupons, inventory, orders, ledger, and store modules.</text>

  <!-- Config and data -->
  <rect class="panel" x="1810" y="150" width="350" height="650" rx="16"/>
  <text class="panelhead" x="1834" y="190">Settings &amp; data</text>
  <rect x="1832" y="212" width="306" height="210" rx="12" fill="#fff9ed" stroke="#f3d49d" stroke-width="1.3"/>
  <text class="path" x="1850" y="242">config.js</text>
  <text class="body" x="1850" y="272">port · shop identity</text>
  <text class="body" x="1850" y="298">HSN GST slabs · default GST</text>
  <text class="body" x="1850" y="324">coupons · inventory defaults</text>
  <text class="small" x="1850" y="382">Used by server.js and rule modules</text>
  <rect x="1832" y="448" width="306" height="310" rx="12" fill="#f4f7ff" stroke="#bdc9ee" stroke-width="1.3"/>
  <text class="path" x="1850" y="478">data/db.json</text>
  <text class="body" x="1850" y="511">products · orders · customers</text>
  <text class="body" x="1850" y="537">settlements · auditLog</text>
  <text class="body" x="1850" y="563">nextOrderId · nextSettlementId</text>
  <line x1="1850" y1="585" x2="2120" y2="585" stroke="#d9e2ee"/>
  <text class="small" x="1850" y="613">One JSON file is read and rewritten</text>
  <text class="small" x="1850" y="635">by lib/store.js.</text>
  <text class="small" x="1850" y="700">No database service is configured.</text>

  <!-- Relationship arrows -->
  <path d="M390 545 L452 545" fill="none" stroke="#0f9d8a" stroke-width="3" marker-end="url(#arrowTeal)"/>
  <text class="tag" x="392" y="530">POST /api/orders</text>
  <path d="M655 320 L655 345" fill="none" stroke="#526782" stroke-width="2.5" marker-end="url(#arrow)"/>
  <text class="small" x="671" y="338">mounts routes</text>
  <path d="M880 545 L920 545" fill="none" stroke="#0f9d8a" stroke-width="3" marker-end="url(#arrowTeal)"/>
  <text class="tag" x="877" y="530">calls</text>
  <path d="M1810 375 L1770 375" fill="none" stroke="#526782" stroke-width="2.5" marker-end="url(#arrow)"/>
  <text class="small" x="1767" y="360">settings</text>
  <path d="M1744 690 L1810 690" fill="none" stroke="#526782" stroke-width="2.5" marker-end="url(#arrow)"/>

  <!-- Order flow -->
  <rect class="panel" x="40" y="835" width="2120" height="590" rx="18"/>
  <text class="panelhead" x="68" y="878">Place an order · request and persistence flow</text>
  <text class="small" x="68" y="904">The preview and final submission both use the pricing rules; the final POST recalculates on the server.</text>

  <rect x="68" y="936" width="382" height="245" rx="14" fill="#f4f9ff" stroke="#d4e1f0"/>
  <circle cx="96" cy="968" r="16" fill="#0f9d8a"/><text class="stepnum" x="91" y="974">1</text>
  <text class="stephead" x="122" y="973">Build and preview</text>
  <text class="stepbody" x="90" y="1012">UI posts cart + coupon to</text>
  <text class="stepbody" x="90" y="1037">POST /api/pricing/preview</text>
  <text class="stepbody" x="90" y="1062">routes/reports.js calls</text>
  <text class="stepbody" x="90" y="1087">lib/pricing.js.</text>

  <rect x="480" y="936" width="382" height="245" rx="14" fill="#f4f9ff" stroke="#d4e1f0"/>
  <circle cx="508" cy="968" r="16" fill="#0f9d8a"/><text class="stepnum" x="503" y="974">2</text>
  <text class="stephead" x="534" y="973">Submit order</text>
  <text class="stepbody" x="502" y="1012">POST /api/orders</text>
  <text class="stepbody" x="502" y="1037">routes/orders.js reads the store,</text>
  <text class="stepbody" x="502" y="1062">resolves product IDs, and checks</text>
  <text class="stepbody" x="502" y="1087">stock and coupon validity.</text>

  <rect x="892" y="936" width="382" height="245" rx="14" fill="#f4f9ff" stroke="#d4e1f0"/>
  <circle cx="920" cy="968" r="16" fill="#0f9d8a"/><text class="stepnum" x="915" y="974">3</text>
  <text class="stephead" x="946" y="973">Calculate totals</text>
  <text class="stepbody" x="914" y="1012">lib/pricing.js applies the coupon</text>
  <text class="stepbody" x="914" y="1037">discount, then HSN GST from</text>
  <text class="stepbody" x="914" y="1062">lib/tax.js; lib/coupons.js supplies</text>
  <text class="stepbody" x="914" y="1087">validation and discount rules.</text>

  <rect x="1304" y="936" width="382" height="245" rx="14" fill="#f4f9ff" stroke="#d4e1f0"/>
  <circle cx="1332" cy="968" r="16" fill="#0f9d8a"/><text class="stepnum" x="1327" y="974">4</text>
  <text class="stephead" x="1358" y="973">Apply order changes</text>
  <text class="stepbody" x="1326" y="1012">Khata mode checks credit via</text>
  <text class="stepbody" x="1326" y="1037">lib/ledger.js. Then inventory is</text>
  <text class="stepbody" x="1326" y="1062">updated and lib/orders.js creates</text>
  <text class="stepbody" x="1326" y="1087">the order record.</text>

  <rect x="1716" y="936" width="414" height="245" rx="14" fill="#f4f9ff" stroke="#d4e1f0"/>
  <circle cx="1744" cy="968" r="16" fill="#0f9d8a"/><text class="stepnum" x="1739" y="974">5</text>
  <text class="stephead" x="1770" y="973">Save and respond</text>
  <text class="stepbody" x="1738" y="1012">Audit entry is appended; store.js</text>
  <text class="stepbody" x="1738" y="1037">rewrites data/db.json and returns</text>
  <text class="stepbody" x="1738" y="1062">the created order (HTTP 201).</text>
  <text class="stepbody" x="1738" y="1087">UI refreshes its data.</text>

  <path d="M450 1058 L480 1058 M862 1058 L892 1058 M1274 1058 L1304 1058 M1686 1058 L1716 1058" fill="none" stroke="#0f9d8a" stroke-width="3" marker-end="url(#arrowTeal)"/>

  <rect x="68" y="1210" width="2062" height="150" rx="14" fill="#eef8f6" stroke="#c6e8e1"/>
  <text class="label" x="92" y="1248">Invoice path after placement</text>
  <text class="body" x="92" y="1282">GET /orders/:id/invoice → server.js → lib/invoice.js → lib/pricing.js → printable HTML.</text>
  <text class="small" x="92" y="1316">Order data is read from data/db.json; invoice tax and totals are recomputed from the stored lines and current config.</text>
</svg>
